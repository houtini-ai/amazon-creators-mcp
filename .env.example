# Amazon Creators API credentials — get from Associates Central
# https://affiliate-program.amazon.com/creatorsapi

# Required
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=yourtag-20

# Credential version — "2.x" for Cognito, "3.x" for Login with Amazon (LwA).
# New credentials issued after ~Feb 2026 are v3.x.
AMAZON_CREDENTIAL_VERSION=3.1

# Marketplace — drives both host selection and the x-marketplace header.
# NA:  www.amazon.com | www.amazon.ca | www.amazon.com.mx | www.amazon.com.br
# EU:  www.amazon.co.uk | www.amazon.de | www.amazon.fr | www.amazon.it | www.amazon.es
#      www.amazon.nl | www.amazon.com.be | www.amazon.eg | www.amazon.in | www.amazon.ie
#      www.amazon.pl | www.amazon.sa | www.amazon.se | www.amazon.com.tr | www.amazon.ae
# FE:  www.amazon.co.jp | www.amazon.sg | www.amazon.com.au
AMAZON_MARKETPLACE=www.amazon.com

# Optional
DEBUG=0
