{
  "name": "@houtini/amazon-creators-mcp",
  "version": "0.3.0",
  "description": "Amazon Creators API MCP Server — blog-friendly affiliate product embeds rendered inline via MCP Apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amazon-creators-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:viewer": "node scripts/build-viewer.mjs",
    "build": "npm run build:viewer && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "msw": "^2.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "amazon",
    "creators-api",
    "affiliate",
    "associates",
    "paapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houtini-ai/amazon-creators-api-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/houtini-ai/amazon-creators-api-mcp/issues"
  },
  "homepage": "https://github.com/houtini-ai/amazon-creators-api-mcp#readme",
  "author": "Houtini AI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
