{
  "name": "@houtini/amazon-creators-mcp",
  "version": "0.4.3",
  "description": "Amazon Creators API MCP Server — blog-friendly affiliate product embeds rendered inline via MCP Apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amazon-creators-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "images",
    "assets/logo.png",
    "assets/icon.png",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:viewer": "node scripts/build-viewer.mjs",
    "build": "npm run build:viewer && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "msw": "^2.13.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "amazon",
    "creators-api",
    "affiliate",
    "associates",
    "paapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houtini-ai/amazon-creators-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/houtini-ai/amazon-creators-mcp/issues"
  },
  "homepage": "https://github.com/houtini-ai/amazon-creators-mcp#readme",
  "author": "Houtini AI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.houtini-ai/amazon-creators"
}
